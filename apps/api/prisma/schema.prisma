generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  owner
  member
}

enum ClientStatus {
  lead
  active
  inactive
  archived
}

enum ProjectStatus {
  draft
  active
  on_hold
  completed
  cancelled
}

enum ProjectPriority {
  low
  medium
  high
  urgent
}

enum StagePhase {
  commercial
  design
  development
}

enum StageStatus {
  pending
  in_progress
  waiting
  blocked
  completed
  skipped
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    Member[]
  ownedClients   Client[] @relation("ClientOwner")
  ownedProjects  Project[] @relation("ProjectOwner")
  activityEvents ActivityEvent[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
  clients   Client[]
  projects  Project[]
  activityEvents ActivityEvent[]
  workflowTemplates WorkflowTemplate[]
  stages    Stage[]
}

model Client {
  id             String       @id @default(cuid())
  workspaceId    String
  name           String
  company        String?
  whatsapp       String?
  email          String?
  ownerUserId    String
  notes          String?
  status         ClientStatus @default(lead)
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User         @relation("ClientOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  projects       Project[]

  @@index([workspaceId])
  @@index([workspaceId, ownerUserId])
  @@index([workspaceId, status])
}

model Project {
  id                 String           @id @default(cuid())
  workspaceId        String
  clientId           String
  name               String
  description        String?
  ownerUserId        String
  status             ProjectStatus    @default(draft)
  startDate          DateTime?
  dueDate            DateTime?
  priority           ProjectPriority  @default(medium)
  progress           Int              @default(0)
  notes              String?
  workflowTemplateId String?
  currentStageId     String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner              User             @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  workflowTemplate   WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  currentStage       Stage?           @relation("ProjectCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  stages             Stage[]          @relation("ProjectStages")

  @@index([workspaceId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@index([workspaceId, ownerUserId])
}

model WorkflowTemplate {
  id          String          @id @default(cuid())
  workspaceId String
  key         String
  name        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages      StageTemplate[]
  projects    Project[]

  @@unique([workspaceId, key])
}

model StageTemplate {
  id                 String           @id @default(cuid())
  workflowTemplateId String
  key                String
  label              String
  phase              StagePhase
  order              Int
  allowedNextKeys    Json
  entryCriteria      String
  exitCriteria       String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@unique([workflowTemplateId, key])
  @@index([workflowTemplateId, order])
}

model Stage {
  id              String      @id @default(cuid())
  workspaceId     String
  projectId       String
  stageTemplateId String?
  key             String
  label           String
  phase           StagePhase
  order           Int
  allowedNextKeys Json
  entryCriteria   String
  exitCriteria    String
  status          StageStatus @default(pending)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project     @relation("ProjectStages", fields: [projectId], references: [id], onDelete: Cascade)
  currentFor      Project[]   @relation("ProjectCurrentStage")

  @@unique([projectId, key])
  @@index([workspaceId, projectId])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  entityType  String
  entityId    String
  action      String
  payload     Json
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
}

model Member {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}
