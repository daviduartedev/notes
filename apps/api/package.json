{
  "name": "@notes/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=./prisma/schema.prisma",
    "start": "prisma migrate deploy --schema=./prisma/schema.prisma && tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@hono/node-server": "^1.19.1",
    "@prisma/client": "6.16.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.9.6",
    "prisma": "6.16.3",
    "tsx": "^4.20.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
